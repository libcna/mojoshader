# Generates mojoshader_version.h for the standalone build. Factored out of the top-level
# CMakeLists.txt so the regression test in tests/cna can run this same logic against a crafted
# git repository whose HEAD is a merge -- the case `git rev-list HEAD~..` could not spell. -CNA

# mojoshader_version_changeset(<srcdir> <outvar>)
#
# Sets <outvar> in the caller's scope to the one-line changeset of the git checkout at <srcdir>:
# "git-<HEAD commit>", or "???" when git or a repository is unavailable.
#
# HEAD is named with `git rev-parse HEAD`. `git rev-list HEAD~..` was used once; it lists every
# commit a merge brings in, one SHA per line, and a multi-line value is not a C string literal, so
# on a merge HEAD -- the fork's own cna branch is one -- the generated header did not compile. -CNA
function(mojoshader_version_changeset srcdir outvar)
    set(changeset "???")
    find_program(MOJOSHADER_GIT git DOC "Path to git command line app: https://git-scm.com/")
    mark_as_advanced(MOJOSHADER_GIT)
    if(NOT MOJOSHADER_GIT)
        message(STATUS "Git not found. You can go on, but version info will be wrong.")
    else()
        # See if we are in a git repository.
        execute_process(
            COMMAND "${MOJOSHADER_GIT}" rev-parse --show-toplevel
            WORKING_DIRECTORY "${srcdir}"
            RESULT_VARIABLE _rc
            OUTPUT_QUIET
            ERROR_QUIET
        )
        if(NOT _rc EQUAL 0)
            message(STATUS "Git repository not found. You can go on, but version info will be wrong.")
        else()
            execute_process(
                COMMAND "${MOJOSHADER_GIT}" rev-parse HEAD
                WORKING_DIRECTORY "${srcdir}"
                RESULT_VARIABLE _rc
                OUTPUT_VARIABLE _sha
                ERROR_QUIET
                OUTPUT_STRIP_TRAILING_WHITESPACE
            )
            if(_rc EQUAL 0)
                set(changeset "git-${_sha}")
            endif()
        endif()
    endif()
    set(${outvar} "${changeset}" PARENT_SCOPE)
endfunction()

# mojoshader_write_version_header(<srcdir> <outdir> <version>)
#
# Writes <outdir>/mojoshader_version.h, naming <srcdir>'s HEAD changeset.
function(mojoshader_write_version_header srcdir outdir version)
    mojoshader_version_changeset("${srcdir}" changeset)
    file(WRITE
        "${outdir}/mojoshader_version.h"
        "/* This file was autogenerated. Do not edit! */\n"
        "#ifndef _INCL_MOJOSHADER_VERSION_H_\n"
        "#define _INCL_MOJOSHADER_VERSION_H_\n"
        "#define MOJOSHADER_VERSION ${version}\n"
        "#define MOJOSHADER_CHANGESET \"${changeset}\"\n"
        "#endif\n"
    )
endfunction()
